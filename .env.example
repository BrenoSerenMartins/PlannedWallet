# Public project configuration; expose only these two values to the frontend.
SUPABASE_URL=https://hlcrjoqmyohfbajvafhh.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=hlcrjoqmyohfbajvafhh

# Server and CLI only. Never expose these values to a frontend build.
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Restricted login created by npm run db:setup; API refuses postgres/admin roles.
RUNTIME_DATABASE_URL=
# Required before using encrypted invoice imports; generate with: openssl rand -base64 32
# Keep this secret in the API host's secret store. Never commit the real value.
FINANCIAL_DATA_KEK_BASE64=
# Optional trusted Supabase root CA file; TLS verification stays enabled.
DATABASE_CA_FILE=
PORT=8083
